# Postgres connection used by Prisma (matches the docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/resto?schema=public

# API port (default 4000)
PORT=4000

# Extra allowed CORS origin for the client (localhost:3000/3001 are always allowed)
CLIENT_ORIGIN=http://localhost:3000

# Bearer token required for /api/admin/* routes. Leave empty to disable admin auth (local dev only).
ADMIN_TOKEN=

# Decimal tax rate applied to the subtotal, e.g. 0.08 for 8%
TAX_RATE=0
